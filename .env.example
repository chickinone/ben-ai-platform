# Sao chép thành .env bằng:  python scripts/init_env.py
# Script thay các placeholder __ALNUMn__ / __HEXn__ bằng giá trị ngẫu nhiên (n ký tự).
# Chỉ dùng chữ và số cho mật khẩu vì chúng được ghép vào connection URL.

# ---- Postgres (dùng chung ở dev: DB ben, keycloak, langfuse) ----
POSTGRES_USER=ben
POSTGRES_PASSWORD=__ALNUM24__
# Cổng trên máy host (trong mạng compose vẫn là 5432). Đổi nếu 55432 bị chiếm.
POSTGRES_HOST_PORT=55432
# Role ứng dụng: không phải owner, chịu Row Level Security (ADR-004)
BEN_APP_DB_PASSWORD=__ALNUM24__

# ---- Redis ----
REDIS_PASSWORD=__ALNUM24__

# ---- MinIO ----
MINIO_ROOT_USER=ben-minio
MINIO_ROOT_PASSWORD=__ALNUM24__

# ---- Keycloak ----
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=__ALNUM24__

# ---- LiteLLM Proxy (ADR-017) ----
LITELLM_MASTER_KEY=sk-__ALNUM32__
# Mã hoá thông tin nhạy cảm LiteLLM lưu trong DB. KHÔNG đổi sau khi đã có dữ liệu.
LITELLM_SALT_KEY=sk-__ALNUM32__
# Khoá AES-256 (64 ký tự hex) mã hoá kho ánh xạ PII trên Redis
BEN_PII_STORE_KEY=__HEX64__

# ---- Langfuse (chỉ dùng khi chạy bản có observability) ----
LANGFUSE_SALT=__ALNUM32__
LANGFUSE_ENCRYPTION_KEY=__HEX64__
LANGFUSE_NEXTAUTH_SECRET=__ALNUM32__
CLICKHOUSE_PASSWORD=__ALNUM24__
LANGFUSE_INIT_USER_EMAIL=admin@ben.local
LANGFUSE_INIT_USER_PASSWORD=__ALNUM20__
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-__HEX32__
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-__HEX32__

# ---- Model (dùng từ tuần 3) ----
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
