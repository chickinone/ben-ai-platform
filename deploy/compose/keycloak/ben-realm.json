{
  "realm": "ben",
  "displayName": "Bến AI Platform (dev)",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "platform-admin", "description": "Quản trị toàn nền tảng" },
      { "name": "tenant-admin", "description": "Quản trị một tenant" },
      { "name": "approver", "description": "Duyệt hành động của agent" },
      { "name": "security", "description": "Xem audit, sự cố guardrail" },
      { "name": "dpo", "description": "Bảo vệ dữ liệu cá nhân" },
      { "name": "data-owner", "description": "Chủ sở hữu dữ liệu" },
      { "name": "data-steward", "description": "Duy trì nhãn và chất lượng dữ liệu" }
    ]
  },
  "groups": [
    { "name": "all-staff" },
    { "name": "dept-cskh" },
    { "name": "dept-sales" },
    { "name": "dept-engineering" },
    { "name": "dept-finance" },
    { "name": "dept-hr" }
  ],
  "clients": [
    {
      "clientId": "ben-portal",
      "name": "Bến Portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3001/*"],
      "webOrigins": ["http://localhost:3001"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ben-demo-cli",
      "name": "CLI demo (chỉ dev)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "minh",
      "email": "minh@shopviet.vn",
      "firstName": "Minh",
      "lastName": "Platform",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "ben-dev-only", "temporary": false }],
      "realmRoles": ["platform-admin"],
      "groups": ["/all-staff"]
    },
    {
